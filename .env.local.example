# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin
ADMIN_EMAIL=your_email@example.com
ADMIN_PASSWORD_HASH=your_bcrypt_password_hash_here
JWT_SECRET=your_very_long_random_jwt_secret_here

# Binance Pay
BINANCE_PAY_MERCHANT_ID=your_binance_merchant_id
BINANCE_PAY_API_KEY=your_binance_api_key
BINANCE_PAY_SECRET_KEY=your_binance_secret_key

# NOWPayments Card-to-Crypto On-Ramp (optional)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret
NOWPAYMENTS_SANDBOX=false

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# US Bank Transfer (Grey / Lead Bank)
NEXT_PUBLIC_US_BANK_HOLDER=your_name
NEXT_PUBLIC_US_BANK_NAME=Lead Bank
NEXT_PUBLIC_US_BANK_ACCOUNT=your_account_number
NEXT_PUBLIC_US_BANK_ROUTING=your_routing_number

# Crypto Wallets
NEXT_PUBLIC_BTC_WALLET=your_btc_address
NEXT_PUBLIC_ETH_WALLET=your_eth_address
NEXT_PUBLIC_USDT_BEP20_WALLET=your_usdt_bep20_address
NEXT_PUBLIC_USDT_TRC20_WALLET=your_usdt_trc20_address
NEXT_PUBLIC_USDT_ERC20_WALLET=your_usdt_erc20_address
NEXT_PUBLIC_BNB_WALLET=your_bnb_address
